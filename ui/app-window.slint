// 此文件定义 ClipboardBoard 的黑色浮动看板、搜索筛选、文本摘要卡片和面板级键盘契约。
// 卡片只接收受限摘要、来源和相对时间，不把完整剪贴板正文放进 UI 模型。
// 历史内容区使用 Slint ListView 的窗口化 repeater，避免为不可见历史创建完整组件树。

import { LineEdit } from "std-widgets.slint";

// ClipboardCard 是 UI 卡片的最小展示 DTO，只允许摘要、来源和相对时间进入组件树。
export struct ClipboardCard {
    // 已按领域规则截断的预览文本，不是完整剪贴板正文。
    preview: string,
    // 来源程序的安全展示名称；缺失时由 Rust 侧提供稳定回退文案。
    source: string,
    // 由应用状态层格式化的相对时间文本。
    relative_time: string,
    // 数据库已经提交的最终收藏状态；pending 期间保持旧值。
    is_pinned: bool,
    // 当前卡片是否正在等待收藏事务结果，用于禁用重复点击。
    pin_pending: bool,
    // 当前卡片是否正在等待删除事务结果；pending 期间卡片仍然可见。
    delete_pending: bool,
    // 图片卡片在缩略图接入前显示稳定占位；文本卡片保持原布局。
    is_image: bool,
    // 文本和图片卡片都通过稳定 ID/哈希请求后台复制，不在 UI 层携带正文或原图。
    copy_enabled: bool,
    // 图片原始尺寸仅用于摘要文案，不参与卡片动态测量。
    image_width: int,
    image_height: int,
    // 后台缩略图在 UI 线程转换后的受限图片；未完成时保持默认空图片。
    thumbnail: image,
    // 显式状态用于区分空图片与加载中占位，不在 Slint 内推断图片内容。
    thumbnail_loaded: bool,
    // 文件缺失或损坏时显示稳定失败占位。
    thumbnail_failed: bool,
}

// ListView 是 Slint 编译器识别的窗口化 Flickable：只有视口附近的重复项会实例化。
// visible-* 属性是编译器进行固定高度布局和虚拟化所需的契约，不能删除或改名。
component ListView inherits Flickable {
    // 编译器用这两个输出属性计算视口尺寸和重复器可见范围。
    out property <length> visible-width <=> self.width;
    out property <length> visible-height <=> self.height;
    @children
}

// AppWindow 是快捷键呼出的临时黑色看板，Rust 侧负责生命周期和事件代次。
export component AppWindow inherits Window {
    // Rust 侧在 UI 线程登记此回调，并用打开代次确保只有当前会话的 Esc 可以隐藏。
    callback panel-dismiss-requested();
    // 上下键只发出方向请求，选择状态和边界夹紧由 Rust UI reducer 统一处理。
    callback selection-move-requested(delta: int);
    // 点击卡片只把当前可见索引交给 Rust；Rust 必须在 UI 线程同步解析稳定记录身份。
    callback card-selection-requested(index: int);
    // 复制按钮只发送当前可见索引；正文读取和系统剪贴板写回只能在后台执行。
    callback copy-item-requested(index: int);
    // 收藏按钮只提交当前索引，Rust 同步解析稳定身份并生成明确期望状态。
    callback pin-item-requested(index: int);
    // 删除按钮只提交当前索引，Rust 必须等待 SQLite 成功后才移除卡片。
    callback delete-item-requested(index: int);
    // 清理入口只打开确认区，不得直接访问存储。
    callback clear-unpinned-requested();
    // 取消确认只关闭确认区，不产生后台请求。
    callback clear-unpinned-cancelled();
    // 二次确认后才允许 Rust 提交清空未收藏事务。
    callback clear-unpinned-confirmed();
    // 带文字的危险入口只打开清空全部强确认区。
    callback clear-all-requested();
    // 强确认输入变化交给 Rust reducer 保存并再次校验。
    callback clear-all-confirmation-text-changed(text: string);
    // 取消强确认不得提交后台事务。
    callback clear-all-cancelled();
    // 点击确认时连同当前输入文字发送，Rust 不信任 enabled 并会再次精确校验。
    callback clear-all-confirmed(text: string);
    // 搜索框文本变化只发送用户主动输入，不把历史正文回传给 Rust。
    callback search-text-changed(text: string);
    // 标签点击只发送稳定索引，未知索引由 Rust 边界转换为“全部”。
    callback search-filter-requested(filter: int);
    // 真实列表滚动或布局变化时上报几何；Rust 只在进入底部阈值的边沿续页。
    callback history-viewport-changed(viewport-y: length, visible-height: length, content-height: length);
    // 续页失败提示是唯一的同区重试入口，普通重绘不能自动重发请求。
    callback retry-history-page-requested();
    forward-focus: panel-focus;

    title: "ClipboardBoard";
    width: 560px;
    height: 640px;
    background: #080808;
    // Rust 侧通过 ModelRc 提供摘要卡片，禁止在这里绑定完整正文或图片原图。
    in property <[ClipboardCard]> cards: [];
    // 鼠标与键盘共用同一选中索引；负数表示当前没有选中卡片。
    in property <int> selected-index: -1;
    // Rust 侧同步搜索框和标签状态，防止旧代次结果回写错误的选中标签。
    in-out property <string> search-text: "";
    in-out property <int> search-filter: 0;
    in property <string> search-status: "idle";
    in property <bool> history-retry-required: false;
    // 收藏失败只展示固定文案，不接收 SQLite 或正文错误详情。
    in property <bool> pin-error-visible: false;
    // 删除失败只展示固定文案，不接收 SQLite、哈希或正文错误详情。
    in property <bool> delete-error-visible: false;
    // 清空确认、处理中和固定失败状态由 Rust reducer 单向同步。
    in property <bool> clear-unpinned-confirmation-visible: false;
    in property <bool> clear-unpinned-pending: false;
    in property <bool> clear-unpinned-error-visible: false;
    // 清空全部拥有独立确认文字和错误状态；pending 与另一清空范围共享。
    in property <bool> clear-all-confirmation-visible: false;
    in-out property <string> clear-all-confirmation-text: "";
    in property <bool> clear-all-pending: false;
    in property <bool> clear-all-error-visible: false;
    // 收藏、删除和两种清空共享的视觉互斥；Rust reducer 仍负责最终权限校验。
    in property <bool> history-mutation-pending: false;
    // 性能探针和后续滚轮交互通过此别名驱动真实列表视口；默认值保持顶部。
    in-out property <length> history-viewport-y <=> history-list.viewport-y;
    // 暴露实际绑定模型的行数，性能探针据此拒绝“只打印常量但模型变小”的伪证。
    out property <int> history-model-length: cards.length;
    out property <length> history-visible-height: history-list.visible-height;
    out property <length> history-viewport-height: history-list.viewport-height;

    panel-focus := FocusScope {
        // 捕获阶段先于搜索框等内部控件执行，确保 Esc 和选择键不会因子控件消费而失效。
        // 所有 Enter 组合都在这里静默消费；复制只允许由后续卡片按钮显式触发。
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                panel-dismiss-requested();
                accept
            } else if (event.text == Key.UpArrow) {
                selection-move-requested(-1);
                accept
            } else if (event.text == Key.DownArrow) {
                selection-move-requested(1);
                accept
            } else if (event.text == Key.Return) {
                accept
            } else {
                reject
            }
        }


        Rectangle {
            background: #080808;

            VerticalLayout {
                x: 24px;
                y: 24px;
                width: parent.width - 48px;
                height: parent.height - 48px;
                spacing: 12px;

                Text {
                    text: "CLIPBOARD";
                    color: #f5f5f5;
                    font-size: 12px;
                    font-weight: 700;
                    letter-spacing: 2px;
                }

                Rectangle {
                    height: 1px;
                    background: #2a2a2a;
                }

                // LineEdit 使用标准文本输入控件；防抖和结果代次由 Rust reducer 统一管理。
                search-input := LineEdit {
                    height: 38px;
                    placeholder-text: "搜索剪贴内容…";
                    text: search-text;
                    edited(text) => {
                        search-text-changed(text);
                    }
                }

                // 清理确认和失败提示归入筛选区的可变高度容器；默认状态仍只占 30px，
                // 避免不可见的零高度控件因外层 spacing 令历史卡片整体下移。
                VerticalLayout {
                    height: 30px
                        + (clear-all-confirmation-visible ? 110px
                            : clear-unpinned-confirmation-visible ? 56px : 0px)
                        + ((clear-unpinned-error-visible || clear-all-error-visible) ? 30px : 0px);
                    spacing: 12px;

                    HorizontalLayout {
                        height: 30px;
                        spacing: 8px;

                        Rectangle {
                            width: 64px;
                            border-radius: 6px;
                            background: search-filter == 0 ? #f5f5f5 : #141414;
                            TouchArea {
                                clicked => { search-filter-requested(0); }
                            }
                            Text {
                                text: "全部";
                                color: search-filter == 0 ? #080808 : #8c8c8c;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            width: 64px;
                            border-radius: 6px;
                            background: search-filter == 1 ? #f5f5f5 : #141414;
                            TouchArea {
                                clicked => { search-filter-requested(1); }
                            }
                            Text {
                                text: "文本";
                                color: search-filter == 1 ? #080808 : #8c8c8c;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            width: 64px;
                            border-radius: 6px;
                            background: search-filter == 2 ? #f5f5f5 : #141414;
                            TouchArea {
                                clicked => { search-filter-requested(2); }
                            }
                            Text {
                                text: "收藏";
                                color: search-filter == 2 ? #080808 : #8c8c8c;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        Rectangle {
                            width: 108px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #3a3a3a;
                            background: #141414;
                            clear-touch := TouchArea {
                                enabled: !history-mutation-pending;
                                clicked => {
                                    if (!history-mutation-pending) {
                                        clear-unpinned-requested();
                                    }
                                }
                            }
                            Text {
                                text: clear-unpinned-pending ? "清理中…" : "清理未收藏";
                                color: clear-unpinned-pending ? #666666 : #cfcfcf;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            width: 92px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #7a3434;
                            background: #1b1111;
                            TouchArea {
                                enabled: !history-mutation-pending;
                                clicked => {
                                    if (!history-mutation-pending) {
                                        clear-all-requested();
                                    }
                                }
                            }
                            Text {
                                text: clear-all-pending ? "清空中…" : "清空全部";
                                color: clear-all-pending ? #666666 : #ff9a9a;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 两种确认共享一个布局槽，避免隐藏控件改变默认卡片位置。
                    Rectangle {
                        visible: clear-unpinned-confirmation-visible || clear-all-confirmation-visible;
                        height: clear-all-confirmation-visible ? 98px
                            : clear-unpinned-confirmation-visible ? 44px : 0px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: clear-all-confirmation-visible ? #7a3434 : #3a3a3a;
                        background: clear-all-confirmation-visible ? #1b1111 : #141414;

                        HorizontalLayout {
                            visible: clear-unpinned-confirmation-visible;
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 8px;

                            Text {
                                text: "将删除所有未收藏记录";
                                color: #d8d8d8;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Rectangle {
                                width: 58px;
                                height: 28px;
                                border-radius: 5px;
                                background: #222222;
                                TouchArea {
                                    clicked => { clear-unpinned-cancelled(); }
                                }
                                Text {
                                    text: "取消";
                                    color: #b8b8b8;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                width: 72px;
                                height: 28px;
                                border-radius: 5px;
                                background: #f2f2f2;
                                TouchArea {
                                    enabled: !history-mutation-pending;
                                    clicked => {
                                        if (!history-mutation-pending) {
                                            clear-unpinned-confirmed();
                                        }
                                    }
                                }
                                Text {
                                    text: "确认清空";
                                    color: #111111;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        VerticalLayout {
                            visible: clear-all-confirmation-visible;
                            padding: 10px;
                            spacing: 8px;

                            Text {
                                text: "将删除全部记录，包括已收藏记录";
                                color: #ffb0b0;
                                font-size: 12px;
                            }

                            HorizontalLayout {
                                height: 38px;
                                spacing: 8px;

                                clear-all-input := LineEdit {
                                    horizontal-stretch: 1;
                                    placeholder-text: "输入“清空全部”";
                                    text: clear-all-confirmation-text;
                                    edited(text) => {
                                        clear-all-confirmation-text-changed(text);
                                    }
                                }

                                Rectangle {
                                    width: 58px;
                                    border-radius: 5px;
                                    background: #2a1c1c;
                                    TouchArea {
                                        clicked => { clear-all-cancelled(); }
                                    }
                                    Text {
                                        text: "取消";
                                        color: #d0aaaa;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    width: 76px;
                                    border-radius: 5px;
                                    background: clear-all-confirmation-text == "清空全部"
                                        ? #f05d5d : #4b2b2b;
                                    TouchArea {
                                        enabled: !history-mutation-pending
                                            && clear-all-confirmation-text == "清空全部";
                                        clicked => {
                                            if (!history-mutation-pending
                                                && clear-all-confirmation-text == "清空全部") {
                                                clear-all-confirmed(clear-all-confirmation-text);
                                            }
                                        }
                                    }
                                    Text {
                                        text: "确认清空";
                                        color: clear-all-confirmation-text == "清空全部"
                                            ? #160808 : #8c6666;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    Text {
                        visible: clear-unpinned-error-visible || clear-all-error-visible;
                        height: (clear-unpinned-error-visible || clear-all-error-visible) ? 18px : 0px;
                        text: clear-all-error-visible ? "清空全部失败，请重试" : "清空失败，请重试";
                        color: #ff8e8e;
                        font-size: 12px;
                    }
                }

                Text {
                    text: "最近复制";
                    color: #f5f5f5;
                    font-size: 20px;
                }

                Text {
                    text: "内容会在这里按最新复制时间排列";
                    color: #8c8c8c;
                    font-size: 14px;
                }

                // ListView 由 Slint 负责滚动和窗口化，Rust 侧只提供 ModelRc 数据。
                // 固定卡片高度让大列表无需测量每个正文的真实高度。
                history-list := ListView {
                    vertical-stretch: 1;
                    changed viewport-y => {
                        history-viewport-changed(
                            self.viewport-y,
                            self.visible-height,
                            self.viewport-height
                        );
                    }
                    changed visible-height => {
                        history-viewport-changed(
                            self.viewport-y,
                            self.visible-height,
                            self.viewport-height
                        );
                    }
                    changed viewport-height => {
                        history-viewport-changed(
                            self.viewport-y,
                            self.visible-height,
                            self.viewport-height
                        );
                    }

                    for card[index] in cards: Rectangle {
                        // 图片卡片提供 176px 预览区，文本卡片保持原有 96px 密度。
                        height: card.is_image ? 186px : 106px;
                        background: transparent;

                        card-background := Rectangle {
                            height: card.is_image ? 176px : 96px;
                            width: parent.width;
                            // 固定高度虚拟卡片必须裁剪子元素，禁止长预览绘制到卡片间隔。
                            clip: true;
                            // 选中态优先于悬停态，确保鼠标离开后仍能辨认当前复制目标。
                            background: index == selected-index
                                ? #242424
                                : card-touch.has-hover ? #1b1b1b : #141414;
                            border-width: index == selected-index ? 2px : 1px;
                            border-color: index == selected-index ? #f5f5f5 : #292929;
                            border-radius: 10px;

                            VerticalLayout {
                                visible: !card.is_image;
                                width: parent.width - 144px;
                                height: parent.height;
                                padding: 14px;
                                spacing: 8px;

                                Text {
                                    text: card.is_image
                                        ? "图片  " + card.image_width + " × " + card.image_height
                                        : card.preview;
                                    // 46px 约容纳三行正文；来源信息始终保留在卡片底部。
                                    height: 46px;
                                    vertical-stretch: 0;
                                    color: #f5f5f5;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                    // 多行文本使用 clip；elide 遇到开头空行时会把 `/*` 变成 `/*...`
                                    // 并吞掉下一行。外层固定卡片已启用 clip，仍能阻止正文越界。
                                    overflow: clip;
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    Text {
                                        text: card.source;
                                        color: #8c8c8c;
                                        font-size: 11px;
                                    }

                                    Text {
                                        text: card.relative_time;
                                        color: #666666;
                                        font-size: 11px;
                                        horizontal-alignment: right;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }

                            if card.is_image: Rectangle {
                                x: 14px;
                                y: 12px;
                                width: parent.width - 172px;
                                height: 112px;
                                background: #0d0d0d;
                                border-width: 1px;
                                border-color: #303030;
                                border-radius: 6px;
                                clip: true;

                                Image {
                                    visible: card.thumbnail_loaded;
                                    width: parent.width;
                                    height: parent.height;
                                    source: card.thumbnail;
                                    image-fit: cover;
                                }

                                Text {
                                    visible: !card.thumbnail_loaded;
                                    text: card.thumbnail_failed ? "图片不可用" : "图片加载中…";
                                    color: #666666;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            if card.is_image: Text {
                                x: 14px;
                                y: 132px;
                                width: parent.width - 172px;
                                text: "图片  " + card.image_width + " × " + card.image_height;
                                color: #f5f5f5;
                                font-size: 12px;
                            }

                            if card.is_image: Text {
                                x: 14px;
                                y: 151px;
                                width: parent.width - 172px;
                                text: card.source + "  ·  " + card.relative_time;
                                color: #777777;
                                font-size: 11px;
                            }

                            card-touch := TouchArea {
                                // 右侧 144px 属于删除、收藏和复制按钮，主体选择区与操作区不重叠。
                                width: parent.width - 144px;
                                clicked => {
                                    card-selection-requested(index);
                                }
                            }

                            delete-button := Rectangle {
                                x: parent.width - 138px;
                                y: (parent.height - self.height) / 2;
                                width: 36px;
                                height: 36px;
                                border-radius: 6px;
                                background: delete-touch.pressed
                                    ? #f5f5f5
                                    : delete-touch.has-hover ? #303030 : #242424;
                                border-width: 1px;
                                border-color: #4a4a4a;

                                Text {
                                    text: card.delete_pending ? "…" : "删";
                                    color: delete-touch.pressed ? #080808 : #f5f5f5;
                                    font-size: card.delete_pending ? 15px : 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                delete-touch := TouchArea {
                                    enabled: !history-mutation-pending && !card.delete_pending;
                                    clicked => {
                                        if (!history-mutation-pending && !card.delete_pending) {
                                            delete-item-requested(index);
                                        }
                                    }
                                }
                            }

                            pin-button := Rectangle {
                                x: parent.width - 94px;
                                y: (parent.height - self.height) / 2;
                                width: 36px;
                                height: 36px;
                                border-radius: 6px;
                                background: pin-touch.pressed
                                    ? #f5f5f5
                                    : pin-touch.has-hover ? #303030 : #242424;
                                border-width: 1px;
                                border-color: card.is_pinned ? #f5f5f5 : #4a4a4a;

                                Text {
                                    text: card.pin_pending ? "…" : card.is_pinned ? "★" : "☆";
                                    color: pin-touch.pressed ? #080808 : #f5f5f5;
                                    font-size: card.pin_pending ? 15px : 18px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                pin-touch := TouchArea {
                                    enabled: !history-mutation-pending && !card.pin_pending;
                                    clicked => {
                                        if (!history-mutation-pending && !card.pin_pending) {
                                            pin-item-requested(index);
                                        }
                                    }
                                }
                            }

                            copy-button := Rectangle {
                                x: parent.width - 50px;
                                y: (parent.height - self.height) / 2;
                                width: 44px;
                                height: 36px;
                                border-radius: 6px;
                                background: copy-touch.pressed
                                    ? #f5f5f5
                                    : copy-touch.has-hover ? #303030 : #242424;
                                border-width: 1px;
                                border-color: #4a4a4a;

                                Text {
                                    text: "复制";
                                    color: copy-touch.pressed ? #080808 : #f5f5f5;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                copy-touch := TouchArea {
                                    enabled: card.copy_enabled;
                                    clicked => {
                                        if (card.copy_enabled) {
                                            copy-item-requested(index);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if history-retry-required: Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: retry-touch.has-hover ? #242424 : #141414;

                    Text {
                        text: "加载失败，点击重试";
                        color: #d99b6c;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    retry-touch := TouchArea {
                        clicked => { retry-history-page-requested(); }
                    }
                }

                if pin-error-visible: Text {
                    text: "收藏更新失败，请重试";
                    color: #d99b6c;
                    font-size: 13px;
                    horizontal-alignment: center;
                }

                if delete-error-visible: Text {
                    text: "删除失败，请重试";
                    color: #d99b6c;
                    font-size: 13px;
                    horizontal-alignment: center;
                }

                if search-status == "loading": Text {
                    text: "搜索中…";
                    color: #8c8c8c;
                    font-size: 13px;
                    horizontal-alignment: center;
                }

                if cards.length == 0 && search-status == "idle": Text {
                    text: "复制一段文本，最新内容会出现在这里";
                    color: #666666;
                    font-size: 13px;
                    horizontal-alignment: center;
                }

                if cards.length == 0 && search-status == "empty": Text {
                    text: "没有匹配的剪贴内容";
                    color: #666666;
                    font-size: 13px;
                    horizontal-alignment: center;
                }

                if search-status == "error": Text {
                    text: "搜索暂不可用，请稍后重试";
                    color: #d99b6c;
                    font-size: 13px;
                    horizontal-alignment: center;
                }

                Rectangle {
                    height: 1px;
                    background: #2a2a2a;
                }

                Text {
                    text: "↑↓ 选择    Esc 关闭";
                    color: #8c8c8c;
                    font-size: 12px;
                }
            }
        }
    }
}
