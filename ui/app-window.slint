// 此文件定义 ClipboardBoard 的黑色浮动看板骨架和面板关闭回调。
// 当前版本只验证生命周期与视觉语法，不包含列表或任何真实剪贴板数据。

export component AppWindow inherits Window {
    // Rust 侧在 UI 线程登记此回调，并用打开代次处理 Esc/失焦竞态。
    callback panel-dismiss-requested();
    forward-focus: panel-focus;

    title: "ClipboardBoard";
    width: 560px;
    height: 640px;
    background: #080808;

    panel-focus := FocusScope {
        // Esc 和失去焦点都只发出请求，是否真的隐藏由 Rust reducer 的代次判断决定。
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                panel-dismiss-requested();
                accept
            }
            reject
        }

        focus-lost => {
            panel-dismiss-requested();
        }

        Rectangle {
            background: #080808;

        VerticalLayout {
            x: 24px;
            y: 24px;
            width: parent.width - 48px;
            height: parent.height - 48px;
            spacing: 12px;

            Text {
                text: "CLIPBOARD";
                color: #f5f5f5;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 2px;
            }

            Rectangle {
                height: 1px;
                background: #2a2a2a;
            }

            Text {
                text: "按 Alt + V 呼出你的剪贴板历史";
                color: #f5f5f5;
                font-size: 22px;
                wrap: word-wrap;
            }

            Text {
                text: "正在建立轻量、本地优先的工作台。";
                color: #8c8c8c;
                font-size: 14px;
            }

            Rectangle {
                vertical-stretch: 1;
            }

            Text {
                text: "Esc 关闭";
                color: #8c8c8c;
                font-size: 12px;
            }
        }
        }
    }
}
