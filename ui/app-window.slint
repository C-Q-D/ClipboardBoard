// 此文件定义 ClipboardBoard 的深色浮动看板、搜索筛选、文本摘要卡片和面板级键盘契约。
// 卡片只接收受限摘要、来源和相对时间，不把完整剪贴板正文放进 UI 模型。
// 历史内容区默认保留旧 ListView 兼容路径；metadata 模式使用普通 Flickable 和精确画布。

import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TextButton } from "components/controls.slint";
import { ClipboardCard, HistoryRowVisual } from "components/history-row.slint";
export { PrimitiveGallery } from "components/controls.slint";

// ListView 是 Slint 编译器识别的窗口化 Flickable：只有视口附近的重复项会实例化。
// visible-* 属性是编译器进行固定高度布局和虚拟化所需的契约，不能删除或改名。
component ListView inherits Flickable {
    // 编译器用这两个输出属性计算视口尺寸和重复器可见范围。
    out property <length> visible-width <=> self.width;
    out property <length> visible-height <=> self.height;
    @children
}

// ThemedText 统一所有界面文字的系统字体；它只负责视觉继承，不持有业务状态。
component ThemedText inherits Text {
    // Microsoft YaHei UI 不可用时由 Slint/Windows 使用系统无衬线回退。
    font-family: Theme.font-family;
}

// HistoryCard 只声明 geometry 路径的 106/186 外层行高；内部视觉统一委托给 HistoryRowVisual。
component HistoryCard inherits Rectangle {
    in property <ClipboardCard> card;
    in property <int> card-index: -1;
    in property <bool> selected: false;
    in property <bool> mutation-pending: false;
    callback card-selected(index: int);
    callback card-copied(index: int);
    callback card-pinned(index: int);
    callback card-deleted(index: int);

    // 显式固定 layout info，避免 ListView 把内部 TouchArea 的默认首选高度叠加到行高。
    preferred-height: card.is_image ? 186px : 106px;
    min-height: self.preferred-height;
    max-height: self.preferred-height;
    background: transparent;

    history-row := HistoryRowVisual {
        width: parent.width;
        height: parent.height;
        card: card;
        card-index: card-index;
        selected: selected;
        mutation-pending: mutation-pending;
        row-selected(index) => { card-selected(index); }
        row-copied(index) => { card-copied(index); }
        row-pinned(index) => { card-pinned(index); }
        row-deleted(index) => { card-deleted(index); }
    }
}

// AppWindow 是快捷键呼出的临时深色看板，Rust 侧负责生命周期和事件代次。
export component AppWindow inherits Window {
    // Rust 侧在 UI 线程登记此回调，并用打开代次确保只有当前会话的 Esc 可以隐藏。
    callback panel-dismiss-requested();
    // 上下键只发出方向请求，选择状态和边界夹紧由 Rust UI reducer 统一处理。
    callback selection-move-requested(delta: int);
    // 点击卡片只把当前可见索引交给 Rust；Rust 必须在 UI 线程同步解析稳定记录身份。
    callback card-selection-requested(index: int);
    // 复制按钮只发送当前可见索引；正文读取和系统剪贴板写回只能在后台执行。
    callback copy-item-requested(index: int);
    // 收藏按钮只提交当前索引，Rust 同步解析稳定身份并生成明确期望状态。
    callback pin-item-requested(index: int);
    // 删除按钮只提交当前索引，Rust 必须等待 SQLite 成功后才移除卡片。
    callback delete-item-requested(index: int);
    // 清理入口只打开确认区，不得直接访问存储。
    callback clear-unpinned-requested();
    // 取消确认只关闭确认区，不产生后台请求。
    callback clear-unpinned-cancelled();
    // 二次确认后才允许 Rust 提交清空未收藏事务。
    callback clear-unpinned-confirmed();
    // 带文字的危险入口只打开清空全部强确认区。
    callback clear-all-requested();
    // 强确认输入变化交给 Rust reducer 保存并再次校验。
    callback clear-all-confirmation-text-changed(text: string);
    // 取消强确认不得提交后台事务。
    callback clear-all-cancelled();
    // 点击确认时连同当前输入文字发送，Rust 不信任 enabled 并会再次精确校验。
    callback clear-all-confirmed(text: string);
    // 搜索框文本变化只发送用户主动输入，不把历史正文回传给 Rust。
    callback search-text-changed(text: string);
    // 标签点击只发送稳定索引，未知索引由 Rust 边界转换为“全部”。
    callback search-filter-requested(filter: int);
    // 真实列表滚动或布局变化时上报几何；Rust 只在进入底部阈值的边沿续页。
    callback history-viewport-changed(viewport-y: length, visible-height: length, content-height: length, origin-token: string);
    // 续页失败提示是唯一的同区重试入口，普通重绘不能自动重发请求。
    callback retry-history-page-requested();
    forward-focus: panel-focus;

    title: "ClipboardBoard";
    width: 720px;
    height: 520px;
    background: Theme.window-bg;
    // Rust 侧通过 ModelRc 提供摘要卡片，禁止在这里绑定完整正文或图片原图。
    in property <[ClipboardCard]> cards: [];
    // legacy repeater 的动态模型；进入 geometry-mode 后强制为空，避免隐藏 ListView 访问旧模型。
    in property <[ClipboardCard]> legacy-cards: geometry-mode ? [] : cards;
    // 显式几何模式的有界窗口卡片；其长度最多 100，不代表完整逻辑数量。
    in property <[ClipboardCard]> window-cards: [];
    // 每个窗口卡片相对于精确内容画布顶部的整数像素偏移。
    in property <[length]> window-offsets: [];
    // metadata 一旦设置即进入显式 Flickable 模式，禁止同时使用 compiler-magic ListView。
    in property <bool> geometry-mode: false;
    // 完整历史数量与窗口模型分离，续页和状态文案只能读取该逻辑数量。
    in property <int> history-logical-count: 0;
    // Rust prefix-sum 计算出的单一内容高度来源。
    in property <length> geometry-content-height: 0px;
    // 几何模式下的视口坐标和窗口绝对起点。
    in-out property <length> geometry-viewport-y <=> geometry-history-list.viewport-y;
    // 程序 clamp 视口时暂存一次性 token；用户滚动回调会携带空字符串。
    in-out property <string> geometry-origin-token: "";
    // Rust 原子替换 cards/offsets/画布期间抑制中间布局回调，最终视口设置后再发出一次完整事件。
    in property <bool> geometry-events-suppressed: false;
    in property <int> window-start: 0;
    in property <int> window-length: 0;
    // 鼠标与键盘共用同一选中索引；负数表示当前没有选中卡片。
    in property <int> selected-index: -1;
    // Rust 侧同步搜索框和标签状态，防止旧代次结果回写错误的选中标签。
    in-out property <string> search-text: "";
    in-out property <int> search-filter: 0;
    in property <string> search-status: "idle";
    // 开机启动操作的稳定反馈；不显示路径、命令行或底层错误详情。
    in property <string> startup-status: "";
    // 续页加载独立于首页搜索状态，避免旧结果保留期间显示错误文案。
    in property <bool> history-next-page-loading: false;
    in property <bool> history-retry-required: false;
    // 收藏失败只展示固定文案，不接收 SQLite 或正文错误详情。
    in property <bool> pin-error-visible: false;
    // 删除失败只展示固定文案，不接收 SQLite、哈希或正文错误详情。
    in property <bool> delete-error-visible: false;
    // 清空确认、处理中和固定失败状态由 Rust reducer 单向同步。
    in property <bool> clear-unpinned-confirmation-visible: false;
    in property <bool> clear-unpinned-pending: false;
    in property <bool> clear-unpinned-error-visible: false;
    // 清空全部拥有独立确认文字和错误状态；pending 与另一清空范围共享。
    in property <bool> clear-all-confirmation-visible: false;
    in-out property <string> clear-all-confirmation-text: "";
    in property <bool> clear-all-pending: false;
    in property <bool> clear-all-error-visible: false;
    // 收藏、删除和两种清空共享的视觉互斥；Rust reducer 仍负责最终权限校验。
    in property <bool> history-mutation-pending: false;
    // 性能探针和后续滚轮交互通过此统一视口属性驱动 legacy 或显式 Flickable；默认值保持顶部。
    in-out property <length> history-viewport-y: 0px;
    // legacy ListView 保留双向别名，使模型替换后的内部 clamp 能同步回统一视口属性。
    in-out property <length> legacy-history-viewport-y <=> history-list.viewport-y;
    // 当前活动路径的完整逻辑数量只用于总数文案，不能被 bounded window 模型替代。
    out property <int> history-active-logical-count: geometry-mode ? history-logical-count : cards.length;
    // 暴露实际绑定重复器的行数；geometry 模式必须是有界 window-cards，而不是逻辑总数。
    out property <int> history-model-length: geometry-mode ? window-cards.length : cards.length;
    out property <length> history-visible-height: geometry-mode ? geometry-history-list.height : history-list.visible-height;
    // 测试接缝只暴露 legacy 分支的实际布局高度，用于证明显式模式不会被隐藏 ListView 占位。
    out property <length> history-legacy-visible-height: history-list.visible-height;
    out property <length> history-viewport-height: geometry-mode ? geometry-content-height : history-list.viewport-height;
    // 外部 setter 根据当前渲染分支写入对应 Flickable；显式模式不触碰隐藏 legacy 列表。
    changed history-viewport-y => {
        if (geometry-mode) {
            geometry-viewport-y = self.history-viewport-y;
        } else {
            legacy-history-viewport-y = self.history-viewport-y;
        }
    }
    // legacy ListView 内部 clamp 时反向同步统一属性；显式模式忽略隐藏列表的零高度变化。
    changed legacy-history-viewport-y => {
        if (!geometry-mode) {
            history-viewport-y = self.legacy-history-viewport-y;
        }
    }

    panel-focus := FocusScope {
        // 捕获阶段先于搜索框等内部控件执行，确保 Esc 和选择键不会因子控件消费而失效。
        // 所有 Enter 组合都在这里静默消费；复制只允许由后续卡片按钮显式触发。
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                panel-dismiss-requested();
                accept
            } else if (event.text == Key.UpArrow) {
                selection-move-requested(-1);
                accept
            } else if (event.text == Key.DownArrow) {
                selection-move-requested(1);
                accept
            } else if (event.text == Key.Return) {
                accept
            } else {
                reject
            }
        }


        // 唯一内容 shell：窗口背景留在外侧，shell 负责圆角裁剪和连续内容表面。
        shell := Rectangle {
            x: Theme.page-inset;
            y: Theme.page-inset;
            width: parent.width - Theme.page-inset - Theme.page-inset;
            height: parent.height - Theme.page-inset - Theme.page-inset;
            background: Theme.shell-bg;
            border-width: 1px;
            border-color: Theme.border-subtle;
            border-radius: Theme.shell-radius;
            clip: true;

            VerticalLayout {
                // shell 内部保留独立 14px padding；外框尺寸变化不能改写业务布局顺序。
                x: Theme.page-inset;
                y: Theme.page-inset;
                width: parent.width - Theme.page-inset - Theme.page-inset;
                height: parent.height - Theme.page-inset - Theme.page-inset;
                spacing: 12px;

                // 固定 54px 顶部工具栏只承载品牌、活动历史总数、搜索和静态快捷键提示。
                toolbar := Rectangle {
                    height: 54px;
                    background: transparent;

                    // 复用仓库已有应用图标资源；图片只负责品牌视觉，不进入业务状态。
                    Image {
                        x: 0px;
                        y: 15px;
                        width: 24px;
                        height: 24px;
                        source: @image-url("../assets/clipboard-board.svg");
                        image-fit: contain;
                    }
                    ThemedText {
                        x: 32px;
                        y: 7px;
                        width: 132px;
                        height: 20px;
                        text: "ClipboardBoard";
                        color: Theme.text-primary;
                        font-size: Theme.section-title-font-size;
                        font-weight: Theme.font-weight-semibold;
                    }
                    ThemedText {
                        x: 32px;
                        y: 29px;
                        width: 120px;
                        height: 16px;
                        text: history-active-logical-count + " 条";
                        color: Theme.text-secondary;
                        font-size: Theme.metadata-font-size;
                    }

                    // LineEdit 仍是唯一用户输入源；防抖、代次和程序回写由 Rust reducer 管理。
                    search-input := LineEdit {
                        x: 168px;
                        y: 8px;
                        width: parent.width - 252px;
                        height: 38px;
                        font-family: Theme.font-family;
                        placeholder-text: "搜索剪贴内容…";
                        text: search-text;
                        edited(text) => {
                            search-text-changed(text);
                        }
                    }

                    // Alt+V 只是静态提示，不注册快捷键，也不设置 TouchArea 或业务回调。
                    Rectangle {
                        x: parent.width - 72px;
                        y: 15px;
                        width: 60px;
                        height: 24px;
                        border-radius: Theme.control-radius;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        background: Theme.surface-bg;
                        ThemedText {
                            text: "Alt + V";
                            color: Theme.text-secondary;
                            font-size: Theme.shortcut-font-size;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // 仅分隔工具栏与内容区；shell 的圆角裁剪仍由外层 Rectangle 负责。
                    Rectangle {
                        y: 53px;
                        width: parent.width;
                        height: 1px;
                        background: Theme.border-subtle;
                    }
                }

                // 工具栏以下明确分隔左侧历史工作区和右侧只读预览占位；右侧没有输入或滚轮接缝。
                Rectangle {
                    // 先让外层 VerticalLayout 分配真实剩余高度，再由内部 HLayout 负责横向分栏；
                    // 这样右侧占位不会退化为仅按文字计算的底部小块。
                    height: parent.height;
                    vertical-stretch: 1;
                    background: transparent;

                    HorizontalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 0px;

                    // 左栏暂定 300px；其内部列表和状态区共享同一个真实伸展高度。
                    VerticalLayout {
                        preferred-width: 300px;
                        min-width: 300px;
                        max-width: 300px;
                        horizontal-stretch: 0;
                        vertical-stretch: 1;
                        spacing: 12px;

                        // 清理确认和失败提示归入筛选区的可变高度容器；默认状态包含 36px 筛选行
                        // 与 30px 清理行，隐藏确认不会让首张卡片获得整卡空白。
                        VerticalLayout {
                            height: 78px
                                + (clear-all-confirmation-visible ? 110px
                                    : clear-unpinned-confirmation-visible ? 56px : 0px)
                                + ((clear-unpinned-error-visible || clear-all-error-visible) ? 30px : 0px);
                            spacing: 12px;

                            HorizontalLayout {
                                height: 36px;
                                spacing: 8px;

                                Rectangle {
                                    width: 64px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: search-filter == 0 ? Theme.border-selected : Theme.border-subtle;
                                    background: search-filter == 0 ? Theme.surface-selected : Theme.surface-bg;
                                    TouchArea {
                                        clicked => { search-filter-requested(0); }
                                    }
                                    ThemedText {
                                        text: "全部";
                                        color: search-filter == 0 ? Theme.accent-text : Theme.text-secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    width: 64px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: search-filter == 1 ? Theme.border-selected : Theme.border-subtle;
                                    background: search-filter == 1 ? Theme.surface-selected : Theme.surface-bg;
                                    TouchArea {
                                        clicked => { search-filter-requested(1); }
                                    }
                                    ThemedText {
                                        text: "文本";
                                        color: search-filter == 1 ? Theme.accent-text : Theme.text-secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    width: 64px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: search-filter == 2 ? Theme.border-selected : Theme.border-subtle;
                                    background: search-filter == 2 ? Theme.surface-selected : Theme.surface-bg;
                                    TouchArea {
                                        clicked => { search-filter-requested(2); }
                                    }
                                    ThemedText {
                                        text: "图片";
                                        color: search-filter == 2 ? Theme.accent-text : Theme.text-secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    width: 64px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: search-filter == 3 ? Theme.border-selected : Theme.border-subtle;
                                    background: search-filter == 3 ? Theme.surface-selected : Theme.surface-bg;
                                    TouchArea {
                                        clicked => { search-filter-requested(3); }
                                    }
                                    ThemedText {
                                        text: "收藏";
                                        color: search-filter == 3 ? Theme.accent-text : Theme.text-secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                    // 清理入口独立成第二行，300px 左栏内仍完整保留两个危险操作。
                    HorizontalLayout {
                        height: 30px;
                        spacing: 8px;

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        clear-unpinned-button := TextButton {
                            width: 108px;
                            label: clear-unpinned-pending ? "清理中…" : "清理未收藏";
                            pending: clear-unpinned-pending;
                            enabled: !history-mutation-pending;
                            clicked => {
                                if (!history-mutation-pending) {
                                    clear-unpinned-requested();
                                }
                            }
                        }

                        Rectangle {
                            width: 92px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.danger;
                            background: Theme.danger-surface;
                            TouchArea {
                                enabled: !history-mutation-pending;
                                clicked => {
                                    if (!history-mutation-pending) {
                                        clear-all-requested();
                                    }
                                }
                            }
                            ThemedText {
                                text: clear-all-pending ? "清空中…" : "清空全部";
                                color: clear-all-pending ? Theme.text-muted : Theme.danger;
                                font-size: Theme.button-font-size;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 两种确认共享一个布局槽，避免隐藏控件改变默认卡片位置。
                    Rectangle {
                        visible: clear-unpinned-confirmation-visible || clear-all-confirmation-visible;
                        height: clear-all-confirmation-visible ? 98px
                            : clear-unpinned-confirmation-visible ? 44px : 0px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: clear-all-confirmation-visible ? Theme.danger : Theme.border-subtle;
                        background: clear-all-confirmation-visible ? Theme.danger-surface : Theme.surface-bg;

                        HorizontalLayout {
                            visible: clear-unpinned-confirmation-visible;
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 8px;

                            ThemedText {
                                text: "将删除所有未收藏记录";
                                color: Theme.text-primary;
                                font-size: Theme.button-font-size;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Rectangle {
                                width: 58px;
                                height: 28px;
                                border-radius: 5px;
                                background: Theme.surface-hover;
                                TouchArea {
                                    clicked => { clear-unpinned-cancelled(); }
                                }
                                ThemedText {
                                    text: "取消";
                                    color: Theme.text-secondary;
                                    font-size: Theme.button-font-size;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                width: 72px;
                                height: 28px;
                                border-radius: 5px;
                                background: Theme.accent-bg;
                                TouchArea {
                                    enabled: !history-mutation-pending;
                                    clicked => {
                                        if (!history-mutation-pending) {
                                            clear-unpinned-confirmed();
                                        }
                                    }
                                }
                                ThemedText {
                                    text: "确认清空";
                                    color: Theme.accent-text;
                                    font-size: Theme.button-font-size;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        VerticalLayout {
                            visible: clear-all-confirmation-visible;
                            padding: 10px;
                            spacing: 8px;

                            ThemedText {
                                text: "将删除全部记录，包括已收藏记录";
                                color: Theme.danger;
                                font-size: Theme.button-font-size;
                            }

                            HorizontalLayout {
                                height: 38px;
                                spacing: 8px;

                                clear-all-input := LineEdit {
                                    font-family: Theme.font-family;
                                    horizontal-stretch: 1;
                                    placeholder-text: "输入“清空全部”";
                                    text: clear-all-confirmation-text;
                                    edited(text) => {
                                        clear-all-confirmation-text-changed(text);
                                    }
                                }

                                Rectangle {
                                    width: 58px;
                                    border-radius: 5px;
                                    background: Theme.danger-surface;
                                    TouchArea {
                                        clicked => { clear-all-cancelled(); }
                                    }
                                    ThemedText {
                                        text: "取消";
                                        color: Theme.text-secondary;
                                        font-size: Theme.button-font-size;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    width: 76px;
                                    border-radius: 5px;
                                    background: clear-all-confirmation-text == "清空全部"
                                        ? Theme.danger : Theme.danger-surface;
                                    TouchArea {
                                        enabled: !history-mutation-pending
                                            && clear-all-confirmation-text == "清空全部";
                                        clicked => {
                                            if (!history-mutation-pending
                                                && clear-all-confirmation-text == "清空全部") {
                                                clear-all-confirmed(clear-all-confirmation-text);
                                            }
                                        }
                                    }
                                    ThemedText {
                                        text: "确认清空";
                                        color: clear-all-confirmation-text == "清空全部"
                                            ? Theme.accent-text : Theme.text-muted;
                                        font-size: Theme.button-font-size;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                }
            }
        }
    }
}

                    ThemedText {
                        visible: clear-unpinned-error-visible || clear-all-error-visible;
                        height: (clear-unpinned-error-visible || clear-all-error-visible) ? 18px : 0px;
                        text: clear-all-error-visible ? "清空全部失败，请重试" : "清空失败，请重试";
                        color: Theme.danger;
                        font-size: Theme.button-font-size;
                    }
                }

                ThemedText {
                    text: "最近复制";
                    color: Theme.text-primary;
                    font-size: Theme.section-title-font-size;
                    font-weight: Theme.font-weight-semibold;
                }

                ThemedText {
                    text: "内容会在这里按最新复制时间排列";
                    color: Theme.text-secondary;
                    font-size: Theme.preview-font-size;
                }

                // metadata 未提供时仍保留旧固定高度 ListView，兼容 ATOM-14R 和旧 set_cards 调用。
                history-list := ListView {
                    visible: !geometry-mode;
                    // 两条列表位于同一个 VerticalLayout；隐藏分支必须释放伸展槽，
                    // 否则旧 ListView 仍会占用一整块高度，把显式列表和首条卡片整体下移。
                    vertical-stretch: geometry-mode ? 0 : 1;
                    min-height: geometry-mode ? 0px : 0px;
                    preferred-height: geometry-mode ? 0px : 0px;
                    max-height: geometry-mode ? 0px : 100000px;
                    changed viewport-y => {
                        // legacy 列表隐藏或重排时只释放布局槽，不得把无效视口写回几何列表。
                        if (!geometry-mode) {
                            history-viewport-y = self.viewport-y;
                            history-viewport-changed(self.viewport-y, self.visible-height, self.viewport-height, "");
                        }
                    }
                    changed visible-height => {
                        if (!geometry-mode) {
                            history-viewport-changed(self.viewport-y, self.visible-height, self.viewport-height, "");
                        }
                    }
                    changed viewport-height => {
                        if (!geometry-mode) {
                            history-viewport-changed(self.viewport-y, self.visible-height, self.viewport-height, "");
                        }
                    }
                    for card[index] in legacy-cards: Rectangle {
                        // legacy 根项必须直接声明固定高度；共享视觉组件不能成为 ListView 的几何真相。
                        height: card.is_image ? 186px : 106px;
                        background: transparent;

                        history-row := HistoryRowVisual {
                            width: parent.width;
                            height: parent.height;
                            card: card;
                            card-index: index;
                            selected: index == selected-index;
                            mutation-pending: history-mutation-pending;
                            row-selected(index) => { card-selection-requested(index); }
                            row-copied(index) => { copy-item-requested(index); }
                            row-pinned(index) => { pin-item-requested(index); }
                            row-deleted(index) => { delete-item-requested(index); }
                        }
                    }
                }

                // metadata 模式只把 bounded window cards 放入普通 Flickable，canvas 高度来自 Rust prefix-sum。
                geometry-history-list := Flickable {
                    visible: geometry-mode;
                    // 与 legacy ListView 互斥分配伸展空间，避免两者在隐藏状态下同时占位。
                    vertical-stretch: geometry-mode ? 1 : 0;
                    min-height: geometry-mode ? 0px : 0px;
                    preferred-height: geometry-mode ? 0px : 0px;
                    max-height: geometry-mode ? 100000px : 0px;
                    // 显式绑定内容高度，避免动态 Rectangle 的 min-height 仍为零导致 viewport-y 被锁在顶部。
                    viewport-height: geometry-content-height;
                    changed viewport-y => {
                        if (geometry-mode && !geometry-events-suppressed) {
                            history-viewport-y = self.viewport-y;
                            let token = geometry-origin-token;
                            geometry-origin-token = "";
                            history-viewport-changed(self.viewport-y, self.height, geometry-content-height, token);
                        }
                    }
                    changed height => {
                        if (geometry-mode && !geometry-events-suppressed) {
                            history-viewport-changed(self.viewport-y, self.height, geometry-content-height, "");
                        }
                    }
                    Rectangle {
                        width: parent.width;
                        height: geometry-content-height;
                        for card[index] in window-cards: HistoryCard {
                            x: 0px;
                            // 绝对定位父容器不会使用 preferred-height，必须显式声明行高，
                            // 否则 HistoryCard delegate 的实际高度为零而完全不可见。
                            y: window-offsets[index];
                            height: card.is_image ? 186px : 106px;
                            width: parent.width;
                            card: card;
                            card-index: index;
                            selected: window-start + index == selected-index;
                            mutation-pending: history-mutation-pending;
                            // Rust 侧把 bounded local index 解析为当前 WindowCommit 的绝对身份。
                            card-selected(index) => { card-selection-requested(index); }
                            card-copied(index) => { copy-item-requested(index); }
                            card-pinned(index) => { pin-item-requested(index); }
                            card-deleted(index) => { delete-item-requested(index); }
                        }
                    }
                }

                // 分页状态区始终占据固定高度，加载/失败切换不能改变列表可见高度。
                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: history-retry-required
                        ? retry-touch.has-hover ? Theme.surface-hover : Theme.surface-bg
                        : transparent;

                    ThemedText {
                        text: history-retry-required
                            ? "加载失败，点击重试"
                            : history-next-page-loading ? "正在加载更多…" : "";
                        color: history-retry-required ? Theme.warning : Theme.text-secondary;
                        font-size: Theme.history-preview-font-size;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    retry-touch := TouchArea {
                        enabled: history-retry-required;
                        clicked => {
                            if (history-retry-required) {
                                retry-history-page-requested();
                            }
                        }
                    }
                }

                if pin-error-visible: ThemedText {
                    text: "收藏更新失败，请重试";
                    color: Theme.warning;
                    font-size: Theme.history-preview-font-size;
                    horizontal-alignment: center;
                }

                if delete-error-visible: ThemedText {
                    text: "删除失败，请重试";
                    color: Theme.warning;
                    font-size: Theme.history-preview-font-size;
                    horizontal-alignment: center;
                }

                if search-status == "loading": ThemedText {
                    text: "搜索中…";
                    color: Theme.text-secondary;
                    font-size: Theme.history-preview-font-size;
                    horizontal-alignment: center;
                }

                if cards.length == 0 && search-status == "idle": ThemedText {
                    text: "复制一段文本，最新内容会出现在这里";
                    color: Theme.text-muted;
                    font-size: Theme.history-preview-font-size;
                    horizontal-alignment: center;
                }

                if cards.length == 0 && search-status == "empty": ThemedText {
                    text: "没有匹配的剪贴内容";
                    color: Theme.text-muted;
                    font-size: Theme.history-preview-font-size;
                    horizontal-alignment: center;
                }

                if search-status == "error": ThemedText {
                    text: "搜索暂不可用，请稍后重试";
                    color: Theme.warning;
                    font-size: Theme.history-preview-font-size;
                    horizontal-alignment: center;
                }

                if startup-status != "": ThemedText {
                    text: startup-status;
                    color: Theme.warning;
                    font-size: Theme.button-font-size;
                    horizontal-alignment: center;
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border-subtle;
                }

                ThemedText {
                    text: "↑↓ 选择    Esc 关闭";
                    color: Theme.text-secondary;
                    font-size: Theme.shortcut-font-size;
                    font-weight: Theme.font-weight-medium;
                }
            }

            // 1px 分隔线是非交互边界，不能承接历史列表的滚轮事件。
            Rectangle {
                preferred-width: 1px;
                min-width: 1px;
                max-width: 1px;
                horizontal-stretch: 0;
                height: parent.height;
                vertical-stretch: 1;
                background: Theme.border-subtle;
            }

            // UIR-05 只建立稳定预览占位；不读取 selected-index，也不注册任何回调。
            Rectangle {
                // 左栏 300px 与分隔线 1px 已固定，右栏宽度随 HLayout 客户区剩余量变化。
                width: parent.width - 300px - 1px;
                vertical-stretch: 1;
                background: Theme.surface-bg;
                border-radius: Theme.control-radius;
                border-width: 1px;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    x: 24px;
                    y: 24px;
                    width: parent.width - 48px;
                    height: parent.height - 48px;
                    spacing: 8px;

                    ThemedText {
                        text: "内容预览";
                        color: Theme.text-primary;
                        font-size: Theme.section-title-font-size;
                        font-weight: Theme.font-weight-semibold;
                    }
                    ThemedText {
                        text: "选择左侧内容后在这里预览";
                        color: Theme.text-secondary;
                        font-size: Theme.preview-font-size;
                        wrap: word-wrap;
                        overflow: clip;
                    }
                }
            }
        }
    }
            }
        }
}
}
