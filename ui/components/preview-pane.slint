// 此文件只负责右栏摘要预览的布局和滚动，不持有选择事实、稳定身份或后台操作。
// 文本内容来自 ClipboardCard.preview 的受限摘要；完整正文和图片原图永远不进入组件。

import { Theme } from "../theme.slint";
import { TextButton } from "controls.slint";
import { ImageIcon } from "icons.slint";
import { ClipboardCard } from "history-row.slint";

// 预览文字统一使用主题字体；组件不把来源、时间或正文复制成第二套状态。
component PreviewText inherits Text {
    font-family: Theme.font-family;
}

// PreviewPane 只展示当前 selected-card 的安全摘要；复制、收藏和删除属于后续原子。
export component PreviewPane inherits Rectangle {
    // Rust 侧传入已经通过完整快照和稳定身份校验的受限 ClipboardCard 摘要。
    in property <ClipboardCard> card;
    // 右栏所有卡片字段都必须受此门禁保护；false 时只显示固定空状态。
    in property <bool> has-selected-card: false;
    // 标题和来源元数据共用固定 46px 头部，正文滚动不能改变右栏外层高度。
    property <length> preview-header-height: 46px;
    // 操作栏固定 54px；正文、图片和尺寸文案必须在其上方结束，不能被按钮遮挡。
    property <length> preview-action-bar-height: 54px;
    // 全局 mutation pending 由 Rust reducer 提供；此处只负责稳定禁用与文案。
    in property <bool> history-mutation-pending: false;
    // 四类失败状态共享一个固定槽；错误详情不进入界面，且优先级只在此处收敛。
    in property <bool> pin-error-visible: false;
    in property <bool> delete-error-visible: false;
    in property <bool> clear-unpinned-error-visible: false;
    in property <bool> clear-all-error-visible: false;
    // 状态槽始终保留固定高度，避免错误出现时挤压正文或操作栏。
    property <length> preview-status-slot-height: 20px;
    property <string> mutation-status-text:
        clear-all-error-visible ? "清空全部失败，请重试"
        : clear-unpinned-error-visible ? "清空失败，请重试"
        : pin-error-visible ? "收藏更新失败，请重试"
        : delete-error-visible ? "删除失败，请重试"
        : history-mutation-pending ? "正在保存更改…"
        : "";
    callback copy-requested();
    callback pin-requested();
    callback delete-requested();

    // 预览是受限摘要；复制仍由 Rust 按稳定身份读取完整内容，本组件不负责复制。

    background: Theme.surface-bg;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: Theme.border-subtle;

    // 内容内缩与列表栏保持一致；右栏自身负责裁剪，不推动外层窗口高度。
    Rectangle {
        x: Theme.content-padding;
        y: Theme.content-padding;
        width: parent.width - Theme.content-padding - Theme.content-padding;
        height: parent.height - Theme.content-padding - Theme.content-padding;
        background: transparent;
        clip: true;

        PreviewText {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 22px;
            text: "内容预览";
            color: Theme.text-primary;
            font-size: Theme.section-title-font-size;
            font-weight: Theme.font-weight-semibold;
            vertical-alignment: center;
        }

        if has-selected-card: PreviewText {
            x: 0px;
            y: 26px;
            width: parent.width;
            height: 16px;
            text: card.source + " · " + card.relative_time;
            color: Theme.text-secondary;
            font-size: Theme.metadata-font-size;
            overflow: clip;
        }

        if !has-selected-card: PreviewText {
            x: 0px;
            y: preview-header-height;
            width: parent.width;
            height: parent.height - preview-header-height - preview-action-bar-height - preview-status-slot-height;
            text: "选择左侧内容后在这里预览";
            color: Theme.text-secondary;
            font-size: Theme.preview-font-size;
            wrap: word-wrap;
            overflow: clip;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if has-selected-card && !card.is_image: Flickable {
            x: 0px;
            y: preview-header-height;
            width: parent.width;
            height: parent.height - preview-header-height - preview-action-bar-height - preview-status-slot-height;
            // viewport-height 与摘要 Text 的实际 preferred-height 同步，长摘要才能滚动。
            viewport-height: preview-text.preferred-height;

            Rectangle {
                width: parent.width;
                height: preview-text.preferred-height;
                background: transparent;

                preview-text := PreviewText {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: self.preferred-height;
                    text: card.preview == "" ? "文本内容为空" : card.preview;
                    color: Theme.text-primary;
                    font-size: Theme.preview-font-size;
                    wrap: word-wrap;
                    overflow: clip;
                    vertical-alignment: top;
                }
            }
        }

        if has-selected-card && card.is_image: Rectangle {
            x: 0px;
            y: preview-header-height;
            width: parent.width;
            height: parent.height - preview-header-height - preview-action-bar-height - preview-status-slot-height - 24px;
            background: Theme.window-bg;
            border-width: 1px;
            border-color: Theme.border-subtle;
            border-radius: Theme.control-radius;
            clip: true;

            // 右栏图片只使用受限 thumbnail，并保持完整比例；绝不读取原图或使用 cover。
            Image {
                visible: card.thumbnail_loaded;
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: parent.height - 16px;
                source: card.thumbnail;
                image-fit: contain;
            }

            if !card.thumbnail_loaded && !card.thumbnail_failed: ImageIcon {
                size: 24px;
                icon-color: Theme.text-muted;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 - 12px;
            }
            if !card.thumbnail_loaded && !card.thumbnail_failed: PreviewText {
                x: 0px;
                y: (parent.height - self.height) / 2 + 18px;
                width: parent.width;
                height: 18px;
                text: "图片加载中…";
                color: Theme.text-muted;
                font-size: Theme.preview-font-size;
                horizontal-alignment: center;
                overflow: clip;
            }
            if !card.thumbnail_loaded && card.thumbnail_failed: ImageIcon {
                size: 24px;
                icon-color: Theme.text-muted;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 - 12px;
            }
            if !card.thumbnail_loaded && card.thumbnail_failed: PreviewText {
                x: 0px;
                y: (parent.height - self.height) / 2 + 18px;
                width: parent.width;
                height: 18px;
                text: "图片不可用";
                color: Theme.text-muted;
                font-size: Theme.preview-font-size;
                horizontal-alignment: center;
                overflow: clip;
            }
        }

        if has-selected-card && card.is_image: PreviewText {
            x: 0px;
            y: parent.height - preview-action-bar-height - preview-status-slot-height - 18px;
            width: parent.width;
            height: 18px;
            text: card.image_width > 0 && card.image_height > 0
                ? card.image_width + " × " + card.image_height
                : "尺寸未知";
            color: Theme.text-secondary;
            font-size: Theme.metadata-font-size;
            horizontal-alignment: center;
            overflow: clip;
        }

        // mutation 状态固定在操作栏上方；空闲时仍保留同样的透明槽位。
        Rectangle {
            x: 0px;
            y: parent.height - preview-action-bar-height - preview-status-slot-height;
            width: parent.width;
            height: preview-status-slot-height;
            background: transparent;

            PreviewText {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                text: mutation-status-text;
                color: clear-all-error-visible || clear-unpinned-error-visible
                    ? Theme.danger
                    : Theme.warning;
                font-size: Theme.metadata-font-size;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: clip;
            }
        }

        // 操作栏是右栏唯一的业务命中区；历史行的整行 TouchArea 不会与它重叠。
        action-bar := Rectangle {
            x: 0px;
            y: parent.height - preview-action-bar-height;
            width: parent.width;
            height: preview-action-bar-height;
            background: Theme.surface-bg;
            border-width: 1px;
            border-color: Theme.border-subtle;

            HorizontalLayout {
                x: 8px;
                y: 9px;
                width: parent.width - 16px;
                height: 36px;
                spacing: 8px;

                pin-button := TextButton {
                    width: 68px;
                    enabled: has-selected-card && !history-mutation-pending && !card.pin_pending;
                    label: card.pin_pending ? "收藏中…" : card.is_pinned ? "取消收藏" : "收藏";
                    clicked => {
                        if (has-selected-card && !history-mutation-pending && !card.pin_pending) {
                            pin-requested();
                        }
                    }
                }

                TextButton {
                    width: 52px;
                    enabled: has-selected-card && !history-mutation-pending && !card.delete_pending;
                    label: card.delete_pending ? "删除中…" : "删除";
                    clicked => {
                        if (has-selected-card && !history-mutation-pending && !card.delete_pending) {
                            delete-requested();
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                copy-button := TextButton {
                    width: 96px;
                    primary: true;
                    enabled: has-selected-card && !history-mutation-pending && card.copy_enabled;
                    label: card.is_image ? "复制图片" : "复制文本";
                    clicked => {
                        if (has-selected-card && !history-mutation-pending && card.copy_enabled) {
                            copy-requested();
                        }
                    }
                }
            }
        }
    }
}
