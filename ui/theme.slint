// ClipboardBoard 的界面令牌唯一来源。
//
// 该全局只保存视觉语义，不持有业务状态、交互回调或数据模型；组件必须通过
// 令牌表达颜色、排版和稳定尺寸，避免同一语义在多个 Slint 文件中发生漂移。
export global Theme {
    // 中性深色表面与灰紫选中态；业务组件不得重新声明十六进制颜色。
    in property <color> window-bg: #09090B;
    in property <color> shell-bg: #101014;
    in property <color> surface-bg: #15151A;
    in property <color> surface-hover: #1E1D25;
    in property <color> surface-selected: #2B2936;
    // 安静分隔线保持低对比度；真正可操作控件使用 control-border，避免边界不可见。
    in property <color> border-subtle: #2A2931;
    in property <color> control-border: #6A6378;
    in property <color> border-selected: #7B748E;
    in property <color> text-primary: #F2F1F5;
    in property <color> text-secondary: #AAA7B0;
    // 元数据仍需在深色表面上达到正文 4.5:1 的最低对比度，不能用不可读的灰色伪装层级。
    in property <color> text-muted: #85818C;
    in property <color> accent-bg: #D8D3E4;
    in property <color> accent-text: #17151B;
    in property <color> focus-ring: #9086A6;
    in property <color> danger: #E98989;
    in property <color> danger-surface: #2A171A;
    in property <color> warning: #D9A06F;
    // 预览滚动条在深色 surface 上保持可见；滚动范围和位置仍由 ScrollView 唯一管理。
    in property <color> scrollbar-track: #25232C;
    in property <color> scrollbar-thumb: #9086A6;

    // 本轮固定的圆角、间距和交互命中尺寸；几何原子会继续复用这些令牌。
    in property <length> shell-radius: 14px;
    in property <length> control-radius: 6px;
    // 客户区只有一个主表面；原来“外边距 14px + shell 内缩 14px”合并为一个内容内缩。
    in property <length> content-inset: 28px;
    in property <length> content-padding: 12px;
    in property <length> section-gap: 10px;
    in property <length> control-hit-size: 36px;
    // 历史项背景向内收 8px，保留列表的连续暗色基底；TouchArea 仍覆盖整行。
    in property <length> history-card-inset: 8px;
    // 筛选项保留 60px 真实命中槽位，选中表面在槽位内收窄成参考图的胶囊形态。
    in property <length> filter-slot-width: 60px;
    in property <length> filter-slot-gap: 8px;
    in property <length> scrollbar-width: 8px;
    in property <length> scrollbar-inset: 4px;
    in property <length> scrollbar-min-thumb-size: 28px;
    // 文本行外层固定 78px；共享视觉中的 70px 背景内含选中边框，不能向外撑高。
    in property <length> history-text-row-height: 78px;
    in property <length> history-text-background-height: 70px;
    // 图片行外层固定 92px；84px 背景保留与文本行一致的 8px 视觉间隔。
    in property <length> history-image-row-height: 92px;
    in property <length> history-image-background-height: 84px;

    // 采用系统字体回退，不把 design 目录中的 WOFF/WOFF2 带入程序。
    in property <string> font-family: "Microsoft YaHei UI";
    // 参考图正文、说明和搜索提示使用轻字重；使用 Windows 已安装字体变体，不增加字体文件。
    in property <string> font-family-light: "Microsoft YaHei UI Light";
    in property <length> app-name-font-size: 16px;
    in property <length> section-title-font-size: 14px;
    in property <length> history-preview-font-size: 13px;
    in property <length> metadata-font-size: 11px;
    in property <length> preview-font-size: 14px;
    in property <length> button-font-size: 12px;
    in property <length> shortcut-font-size: 11px;
    in property <length> pending-font-size: 15px;
    in property <length> icon-font-size: 18px;
    in property <int> font-weight-regular: 400;
    in property <int> font-weight-medium: 500;
    in property <int> font-weight-semibold: 600;
}
